MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/portfolio
USE_MEMORY_DB=false
JWT_SECRET=cambiar-por-clave-larga-y-aleatoria-minimo-32-chars
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5174

# En Railway: Settings → Deploy → Serverless (se duerme ~10 min sin uso).
# El backend cierra Mongo a los 2 min de inactividad para que el sleep funcione.

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Aviso cuando llega un lead (opcional). Sin esto, el lead se loguea en consola.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Agente de cotización (opcional). Sin esto, arma la propuesta con el catálogo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
